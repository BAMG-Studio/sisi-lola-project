# Sisi Lola Control Center - Environment Variables Template

# ============ CONTROL CENTER CONFIGURATION ============
JWT_SECRET_KEY=change-this-to-a-secure-random-string-min-32-characters
DATABASE_URL=sqlite:///./sisi_lola_control.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/sisilola_db

# Domain Configuration
DOMAIN_PUBLIC=https://sisilola.io
DOMAIN_APP=https://app.sisilola.io
DOMAIN_API=https://api.sisilola.io

# CORS Configuration
CORS_ORIGINS=https://www.sisilola.io,https://app.sisilola.io,http://localhost:3000

# Admin Configuration
ADMIN_SECRET_KEY=sisi_lola_live@90

# ============ EXISTING CONFIGURATION ============

# YouTube / Sisi Lola
YOUTUBE_PLATFORM_NAME=YouTube
YOUTUBE_HANDLE=@SisiLolaLive
YOUTUBE_PROFILE_URL=https://www.youtube.com/@SisiLolaLive
YOUTUBE_EMAIL=sisilolalive@gmail.com
YOUTUBE_CHANNEL_ID=UCeWcJZHozas9rpr7XkBR7gA
YOUTUBE_LINK_WEBSITE=sisilola.io

# Google Cloud / YouTube Data API v3
GOOGLE_PROJECT_NAME=Sisi Lola YouTube API
GOOGLE_PROJECT_ID=sisi-lola-youtube-api
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_OAUTH_CLIENT_ID=your_oauth_client_id
YOUTUBE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# AI Services
OPENAI_API_KEY=your_openai_key
PERPLEXITY_API_KEY=your_perplexity_key
HEYGEN_API_KEY=your_heygen_key
HEYGEN_AVATAR_ID=Hada_Casual_Front_public
KLINGAI_ACCESS_KEY=your_klingai_access_key
KLINGAI_SECRET_KEY=your_klingai_secret_key
ELEVENLABS_API_KEY=your_elevenlabs_key

# Google AI Studio
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_key
SISI_LOLA_VOICE_SPEAKER=KORE

# HuggingFace
HUGGINGFACE_TOKEN=your_huggingface_token
NATLAS_MODEL_ID=NCAIR1/N-ATLaS

# Cohere
COHERE_API_KEY=your_cohere_key
COHERE_MODEL=command-r-plus-08-2024

# Nigerian Models
NIGERIAN_BRAIN_MODEL=NCAIR1/N-ATLaS-8B
NIGERIAN_MODELS_ENABLED=true

# ============ RECCLOUD VIDEO INGESTION ============
# RecCloud API for video transcription
RECCLOUD_API_KEY=your_reccloud_api_key

# Video source directory
VIDEO_SOURCE_DIR=C:/Users/YourName/Dropbox/SLS/SL TRAINING VIDEOS

# Output directory for training data
RECCLOUD_OUTPUT_DIR=ml_training/datasets/video_training_data

# Transcription backend: "reccloud" or "modal"
TRANSCRIPTION_BACKEND=reccloud

# ============ MODAL (OPTIONAL) ============
# Modal serverless for GPU Whisper transcription
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
