# Sisi Lola Control Center - Environment Variables Template

# ============ CONTROL CENTER CONFIGURATION ============
JWT_SECRET_KEY=your-secure-random-string
DATABASE_URL=sqlite:///./sisi_lola_control.db

# Domain Configuration
DOMAIN_PUBLIC=https://yourdomain.io
DOMAIN_APP=https://app.yourdomain.io
DOMAIN_API=https://api.yourdomain.io

# CORS Configuration
CORS_ORIGINS=https://www.yourdomain.io,https://app.yourdomain.io,http://localhost:3000

# Admin Configuration
ADMIN_SECRET_KEY=your-admin-secret

# ============ EXISTING CONFIGURATION ============

# YouTube / Sisi Lola
YOUTUBE_PLATFORM_NAME=YouTube
YOUTUBE_HANDLE=@YourHandle
YOUTUBE_PROFILE_URL=https://www.youtube.com/@YourHandle
YOUTUBE_EMAIL=your-email@gmail.com
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_LINK_WEBSITE=your-website.io

# Google Cloud / YouTube Data API v3
GOOGLE_PROJECT_NAME=Sisi Lola YouTube API
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=your-client-secret

# AI Services
OPENAI_API_KEY=your-openai-key
PERPLEXITY_API_KEY=your-perplexity-key
HEYGEN_API_KEY=your-heygen-key
HEYGEN_AVATAR_ID=your-avatar-id
KLINGAI_ACCESS_KEY=your-kling-access-key
KLINGAI_SECRET_KEY=your-kling-secret-key
ELEVENLABS_API_KEY=your-elevenlabs-key

# Google AI Studio / Cloud
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-key
SISI_LOLA_VOICE_SPEAKER=KORE

# HuggingFace
HUGGINGFACE_TOKEN=your-huggingface-token
NATLAS_MODEL_ID=NCAIR1/N-ATLaS

# Cohere
COHERE_API_KEY=your-cohere-key
COHERE_MODEL=command-r-plus-08-2024

# Nigerian Models
NIGERIAN_BRAIN_MODEL=NCAIR1/N-ATLaS-8B
NIGERIAN_MODELS_ENABLED=true

# ============ RECCLOUD VIDEO INGESTION ============
RECCLOUD_API_KEY=your-reccloud-key
VIDEO_SOURCE_DIR=/path/to/your/videos
RECCLOUD_OUTPUT_DIR=ml_training/datasets/video_training_data
TRANSCRIPTION_BACKEND=reccloud

# ============ MODAL (OPTIONAL) ============
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret
